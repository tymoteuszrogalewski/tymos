[Unit]
Description=TymOS ONVIF Bridge
After=network.target mosquitto.service mariadb.service
Wants=mosquitto.service mariadb.service

[Service]
Type=simple
WorkingDirectory=/opt/tymos
ExecStart=/opt/tymos/venv/bin/python3 -u /opt/tymos/daemons/bridge_onvif.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tymos-onvif-bridge

[Install]
WantedBy=multi-user.target
