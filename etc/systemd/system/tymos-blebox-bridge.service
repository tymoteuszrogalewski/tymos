[Unit]
Description=TymOS blebox-bridge
After=network.target mosquitto.service mariadb.service
Wants=mosquitto.service mariadb.service

[Service]
Type=simple
WorkingDirectory=/opt/tymos
ExecStart=/opt/tymos/venv/bin/python3 -u /opt/tymos/daemons/bridge_blebox.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tymos-blebox-bridge

[Install]
WantedBy=multi-user.target
